{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "cds serve",
      "request": "launch",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "cds",
      "args": [
        "serve",
        "--with-mocks",
        "--in-memory?"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Run verification-1",
      "type": "java",
      "request": "launch",
      "args": [
        "--spring.profiles.active=default"
      ],
      "mainClass": "customer.verification.Application",
      "projectName": "verification",
      "preLaunchTask": "PreLaunchTask for Run verification-1",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/env/.env1",
      "env": {
        "run.config": "{\"handlerId\":\"cap_java_run_config_handler_id\",\"runnableId\":\"{\\\"projectPath\\\":\\\"/home/user/projects/verification\\\",\\\"profileName\\\":\\\"default\\\"}\"}"
      }
    },
    {
      "name": "Local_Run verification-2",
      "type": "java",
      "request": "launch",
      "args": [
        "--spring.profiles.active=default,mocked"
      ],
      "mainClass": "customer.verification.Application",
      "projectName": "verification",
      "vmArgs": "-Dspring.profiles.active=mocked",
      "preLaunchTask": "PreLaunchTask for Run verification-2",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/env/.env2",
      "env": {
        "run.config": "{\"handlerId\":\"cap_java_run_config_handler_id\",\"runnableId\":\"{\\\"projectPath\\\":\\\"/home/user/projects/verification\\\",\\\"profileName\\\":\\\"default\\\"}\"}"
      }
    }
  ]
}